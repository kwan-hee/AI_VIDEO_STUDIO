{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ProviderSDK",
  "description": "Provider SDK 공통 계약. providers/provider_sdk.py 의 표준 request/result 형식. 실공급자 구현 전 인터페이스만 정의. 실행/미디어 없음.",
  "definitions": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "capability", "prompt", "parameters", "inputs"],
      "properties": {
        "provider": {
          "type": "string",
          "enum": ["Nano Banana", "Google Flow", "Higgsfield", "Magnific", "Edge TTS", "FFmpeg"]
        },
        "capability": {
          "type": "string",
          "enum": ["generate_image", "generate_video", "enhance_image", "text_to_speech", "compose"]
        },
        "prompt": { "type": ["string", "null"] },
        "parameters": { "type": "object" },
        "inputs": { "type": "array", "items": { "type": "string" } }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "capability", "status", "output", "message"],
      "properties": {
        "provider": {
          "type": "string",
          "enum": ["Nano Banana", "Google Flow", "Higgsfield", "Magnific", "Edge TTS", "FFmpeg"]
        },
        "capability": {
          "type": "string",
          "enum": ["generate_image", "generate_video", "enhance_image", "text_to_speech", "compose"]
        },
        "status": {
          "type": "string",
          "enum": ["success", "failed", "pending"]
        },
        "output": { "type": ["object", "null"] },
        "message": { "type": "string" }
      }
    }
  }
}
