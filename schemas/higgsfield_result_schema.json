{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HiggsfieldResult",
  "description": "Higgsfield Provider 출력 계약. providers/higgsfield_provider.py generate() 반환 형식. Provider SDK result 형식을 따르며 output 구조를 영상 생성에 맞게 제약.",
  "type": "object",
  "additionalProperties": false,
  "required": ["provider", "capability", "status", "output", "message"],
  "properties": {
    "provider": { "type": "string", "enum": ["Higgsfield"] },
    "capability": { "type": "string", "enum": ["generate_video"] },
    "status": { "type": "string", "enum": ["success", "failed", "pending"] },
    "output": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "type", "mock", "prompt"],
          "properties": {
            "path": { "type": "string", "minLength": 1 },
            "type": { "type": "string", "enum": ["video"] },
            "mock": { "type": "boolean" },
            "prompt": { "type": ["string", "null"] }
          }
        }
      ]
    },
    "message": { "type": "string" }
  }
}
