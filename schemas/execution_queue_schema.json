{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ExecutionQueue",
  "description": "Execution Manager 출력 계약. execution/execution_manager.py ExecutionQueue.to_dict() 반환 형식. 상태 큐, 실행 아님.",
  "type": "object",
  "additionalProperties": false,
  "required": ["project", "queue"],
  "properties": {
    "project": {
      "type": "string",
      "enum": ["malli", "baseball", "thumbnail", "blog", "unknown"]
    },
    "queue": {
      "type": "array",
      "items": { "$ref": "#/definitions/queue_item" }
    }
  },
  "definitions": {
    "queue_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order", "step", "provider", "action", "state", "payload"],
      "properties": {
        "order": { "type": "integer", "minimum": 1 },
        "step": {
          "type": "string",
          "enum": ["story", "script", "outline", "article", "image", "video", "voice", "thumbnail", "edit"]
        },
        "provider": {
          "type": ["string", "null"],
          "enum": ["Google Flow", "Higgsfield", "Nano Banana", "Edge TTS", "Magnific", "FFmpeg", null]
        },
        "action": {
          "type": ["string", "null"],
          "enum": ["generate_image", "enhance_image", "generate_video", "text_to_speech", "compose", null]
        },
        "state": {
          "type": "string",
          "enum": ["pending", "ready", "running", "completed", "failed"]
        },
        "payload": { "type": ["object", "null"] }
      }
    }
  }
}
