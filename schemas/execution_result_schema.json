{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ExecutionResult",
  "description": "Execution Runner 출력 계약. runner/execution_runner.py run() 반환 형식. 상태 전이 결과, 실제 실행 아님.",
  "type": "object",
  "additionalProperties": false,
  "required": ["project", "status", "summary", "steps"],
  "properties": {
    "project": {
      "type": "string",
      "enum": ["malli", "baseball", "thumbnail", "blog", "unknown"]
    },
    "status": {
      "type": "string",
      "enum": ["completed", "failed", "empty", "incomplete"]
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "completed", "failed", "pending"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "completed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "pending": { "type": "integer", "minimum": 0 }
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["order", "step", "provider", "state"],
        "properties": {
          "order": { "type": "integer", "minimum": 1 },
          "step": {
            "type": "string",
            "enum": ["story", "script", "outline", "article", "image", "video", "voice", "thumbnail", "edit"]
          },
          "provider": {
            "type": ["string", "null"],
            "enum": ["Google Flow", "Higgsfield", "Nano Banana", "Edge TTS", "Magnific", "FFmpeg", null]
          },
          "state": {
            "type": "string",
            "enum": ["pending", "ready", "running", "completed", "failed"]
          }
        }
      }
    }
  }
}
