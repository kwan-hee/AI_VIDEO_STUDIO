{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Timeline",
  "description": "Timeline Builder 출력 계약. timeline/timeline_builder.py build_timeline() 반환 형식. 실행 계획+등록 에셋으로 만든 미디어 타임라인. 실행 아님, 배치만.",
  "type": "object",
  "additionalProperties": false,
  "required": ["project", "entries", "total_duration"],
  "properties": {
    "project": {
      "type": "string",
      "enum": ["malli", "baseball", "thumbnail", "blog", "unknown"]
    },
    "total_duration": { "type": "number", "minimum": 0 },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["asset_id", "asset_type", "start_time", "end_time", "duration", "layer"],
        "properties": {
          "asset_id": { "type": "string", "minLength": 1 },
          "asset_type": {
            "type": "string",
            "enum": ["image", "video", "audio"]
          },
          "start_time": { "type": "number", "minimum": 0 },
          "end_time": { "type": "number", "minimum": 0 },
          "duration": { "type": "number", "exclusiveMinimum": 0 },
          "layer": {
            "type": "string",
            "enum": ["visual", "audio"]
          }
        }
      }
    }
  }
}
