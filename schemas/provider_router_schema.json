{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ProviderRouterSelection",
  "description": "Provider Router 출력 계약. routing/provider_router.py route() 반환 형식. capability 별 공급자 선택 결과. 실행 아님, 선택만.",
  "type": "object",
  "additionalProperties": false,
  "required": ["capability", "primary", "backup", "candidates", "selected"],
  "properties": {
    "capability": {
      "type": "string",
      "enum": ["generate_image", "generate_video", "enhance_image", "text_to_speech", "compose"]
    },
    "primary": {
      "type": "string",
      "enum": ["Nano Banana", "Google Flow", "Higgsfield", "Magnific", "Edge TTS", "FFmpeg"]
    },
    "backup": {
      "type": ["string", "null"],
      "enum": ["Nano Banana", "Google Flow", "Higgsfield", "Magnific", "Edge TTS", "FFmpeg", null]
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": ["Nano Banana", "Google Flow", "Higgsfield", "Magnific", "Edge TTS", "FFmpeg"]
      }
    },
    "selected": {
      "type": ["string", "null"],
      "enum": ["Nano Banana", "Google Flow", "Higgsfield", "Magnific", "Edge TTS", "FFmpeg", null]
    }
  }
}
