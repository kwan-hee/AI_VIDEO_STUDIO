{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PipelineResult",
  "description": "End-to-End Pipeline Runner 출력 계약. pipeline/pipeline_runner.py run_pipeline() 반환 형식. 요청 하나가 전체 아키텍처를 통과해 만든 통합 실행 결과. 실 외부호출/실 ffmpeg 없음.",
  "type": "object",
  "additionalProperties": false,
  "required": ["request", "project", "status", "asset_count", "providers_used", "final_output", "workflow"],
  "properties": {
    "request": { "type": "string", "minLength": 1 },
    "project": {
      "type": "string",
      "enum": ["malli", "baseball", "thumbnail", "blog", "unknown"]
    },
    "status": {
      "type": "string",
      "enum": ["success", "needs_clarification", "partial", "failed", "empty"]
    },
    "asset_count": { "type": "integer", "minimum": 0 },
    "providers_used": {
      "type": "array",
      "items": {
        "type": ["string", "null"],
        "enum": ["Nano Banana", "Google Flow", "Higgsfield", "Magnific", "Edge TTS", "FFmpeg", null]
      }
    },
    "final_output": { "type": ["string", "null"] },
    "workflow": { "type": "object" }
  }
}
