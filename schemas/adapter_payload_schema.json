{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AdapterPayloadSet",
  "description": "Provider Adapter 출력 계약. adapters/provider_adapter.py build_payloads() 반환 형식. 준비된 공급자 페이로드, 실행 아님.",
  "type": "object",
  "additionalProperties": false,
  "required": ["project", "payloads"],
  "properties": {
    "project": {
      "type": "string",
      "enum": ["malli", "baseball", "thumbnail", "blog", "unknown"]
    },
    "payloads": {
      "type": "array",
      "items": { "$ref": "#/definitions/payload" }
    }
  },
  "definitions": {
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "action", "prompt", "parameters"],
      "properties": {
        "provider": {
          "type": "string",
          "enum": ["Google Flow", "Higgsfield", "Nano Banana", "Edge TTS", "Magnific", "FFmpeg"]
        },
        "action": {
          "type": "string",
          "enum": ["generate_image", "enhance_image", "generate_video", "text_to_speech", "compose"]
        },
        "prompt": { "type": ["string", "null"] },
        "parameters": { "type": "object" }
      }
    }
  }
}
