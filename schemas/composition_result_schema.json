{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CompositionResult",
  "description": "FFmpeg Composer 출력 계약. composer/ffmpeg_composer.py compose() 반환 형식. 최종 MP4 합성 결과.",
  "type": "object",
  "additionalProperties": false,
  "required": ["provider", "action", "status", "output_path", "format", "inputs_used", "message"],
  "properties": {
    "provider": { "type": "string", "enum": ["FFmpeg"] },
    "action": { "type": "string", "enum": ["compose"] },
    "status": { "type": "string", "enum": ["success", "failed"] },
    "output_path": { "type": ["string", "null"] },
    "format": { "type": "string", "enum": ["mp4"] },
    "inputs_used": {
      "type": "object",
      "additionalProperties": false,
      "required": ["images", "videos", "audio"],
      "properties": {
        "images": { "type": "integer", "minimum": 0 },
        "videos": { "type": "integer", "minimum": 0 },
        "audio": { "type": "integer", "minimum": 0 }
      }
    },
    "message": { "type": "string" }
  }
}
