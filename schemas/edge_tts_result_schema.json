{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EdgeTtsResult",
  "description": "Edge TTS Executor 출력 계약. executors/edge_tts_executor.py run() 반환 형식. 실제 mp3 합성 결과.",
  "type": "object",
  "additionalProperties": false,
  "required": ["provider", "action", "status", "output_path", "format", "voice", "rate", "message"],
  "properties": {
    "provider": { "type": "string", "enum": ["Edge TTS"] },
    "action": { "type": "string", "enum": ["text_to_speech"] },
    "status": { "type": "string", "enum": ["success", "failed"] },
    "output_path": { "type": ["string", "null"] },
    "format": { "type": "string", "enum": ["mp3"] },
    "voice": { "type": "string" },
    "rate": { "type": "string" },
    "message": { "type": "string" }
  }
}
