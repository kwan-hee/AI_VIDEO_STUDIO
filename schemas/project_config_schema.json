{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ProjectConfig",
  "description": "Project Configuration 계약. config/project_config.py 가 로드/검증하는 프로젝트 전체 설정. 실행 아님, 설정만.",
  "type": "object",
  "additionalProperties": false,
  "required": ["project", "providers", "voice", "video", "timeline", "output"],
  "properties": {
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description", "output_directory"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "output_directory": { "type": "string", "minLength": 1 }
      }
    },
    "providers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "enhance", "video", "tts", "compose"],
      "properties": {
        "image": { "$ref": "#/definitions/providerKey" },
        "enhance": { "$ref": "#/definitions/providerKey" },
        "video": { "$ref": "#/definitions/providerKey" },
        "tts": { "$ref": "#/definitions/providerKey" },
        "compose": { "$ref": "#/definitions/providerKey" }
      }
    },
    "voice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["speaker", "rate"],
      "properties": {
        "speaker": { "type": "string", "minLength": 1 },
        "rate": { "type": "string" }
      }
    },
    "video": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resolution", "fps", "aspect_ratio"],
      "properties": {
        "resolution": { "type": "string", "minLength": 1 },
        "fps": { "type": "integer", "minimum": 1 },
        "aspect_ratio": { "type": "string", "minLength": 1 }
      }
    },
    "timeline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default_transition", "default_duration"],
      "properties": {
        "default_transition": { "type": "string" },
        "default_duration": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "overwrite"],
      "properties": {
        "format": { "type": "string", "enum": ["mp4"] },
        "overwrite": { "type": "boolean" }
      }
    }
  },
  "definitions": {
    "providerKey": {
      "type": "string",
      "enum": ["nano_banana", "magnific", "higgsfield", "google_flow", "edge_tts", "ffmpeg"]
    }
  }
}
